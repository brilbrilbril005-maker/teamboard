# Скопируйте этот файл в .env.local и заполните значения.
# Настоящие значения в репозиторий не попадают: .env* в .gitignore (кроме этого примера).

# Подключение к PostgreSQL
DATABASE_URL=postgres://teamboard:teamboard@localhost:5432/teamboard

# Публичный адрес приложения (на хостинге — https://ваш-домен)
APP_URL=http://localhost:3000

# Секрет для подписи сессий, не короче 32 символов. Сгенерировать: openssl rand -base64 32
AUTH_SECRET=

# Применять миграции базы при старте сервера (true/false)
RUN_MIGRATIONS=true

# Заполнить пустую базу демо-данными при старте (true/false). Требует DEMO_PASSWORD
SEED_DEMO_DATA=false

# Пароль демо-аккаунтов (anna, olga, maxim, dmitry), не короче 8 символов.
# Если не задан — кнопка «Войти как демо» скрыта
DEMO_PASSWORD=

# --- Только для docker compose ---
# Пароль базы данных в контейнере (DATABASE_URL compose соберёт сам)
POSTGRES_PASSWORD=
# Порт, на котором приложение будет доступно на сервере
APP_PORT=3000
